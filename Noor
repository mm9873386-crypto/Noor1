            <p id="modalOperator" class="text-xs text-slate-400"></p>
          </div>
        </div>
        <button onclick="closeModal()" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="space-y-4 text-xs max-h-[65vh] overflow-y-auto custom-scroll pr-1">
        <div>
          <label class="block text-slate-400 font-semibold mb-1">المعرف (Log ID):</label>
          <div class="flex items-center gap-2 bg-slate-950 p-2.5 rounded-lg border border-slate-800">
            <span id="modalLogId" class="mono-text text-emerald-400 flex-1 truncate"></span>
            <button onclick="copyToClipboard(document.getElementById('modalLogId').innerText)" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-300">نسخ</button>
          </div>
        </div>

        <div>
          <label class="block text-slate-400 font-semibold mb-1">المفتاح العام (Public Key - Base64):</label>
          <div class="relative bg-slate-950 p-2.5 rounded-lg border border-slate-800">
            <pre id="modalKey" class="mono-text text-slate-300 text-[11px] whitespace-pre-wrap break-all max-h-24 overflow-y-auto custom-scroll"></pre>
            <button onclick="copyToClipboard(document.getElementById('modalKey').innerText)" class="absolute top-2 left-2 px-2 py-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-300 text-[10px]">نسخ</button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3" id="modalExtraFields"></div>
      </div>
    </div>
  </div>

